
<h1><%= title %></h1>
<%- messages() %>

<% if (accountData) { %>
  <h2>Welcome <%=accountData.account_firstname %></h2>
  <p>
    <a href="/account/update/<%= accountData.account_id %>">Update Account Information</a>
  </p>
<p> <br></p>
  <% if (accountData.account_type === "Admin" || accountData.account_type === "Employee") { %>
    <h3>Inventory Management</h3>
    <p>
      <a href="/inv">Go to Inventory Management</a>
    </p>
  <% } %>
<p> <br></p>
  <h3>Message Management</h3>
  <ul>
    <li><a href="/message/inbox">Inbox</a></li>
    <li><a href="/message/sent">Sent Messages</a></li>
    <li><a href="/message/new">Compose New Message</a></li>
  </ul>

  <% } else { %>
    <h2>Welcome Guest</h2>
    <p>Please <a href="/account/login">login</a> to access your account.</p>
<% } %>