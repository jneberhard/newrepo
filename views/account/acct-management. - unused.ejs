<title><%= title %></title>
<h1>Manage the Account</h1>

<%- messages() %>

<% if (accountData.account_type === "Client")  %>
    <h2>Welcome <%= accountData.account_firstname %></h2>
<% else if (accountData.account_type === "Admin" || accountData.account_type === "Employee") %>
    <h2>Welcome <%= accountData.account_firstname %></h2>
    <h3>Your account has elevated privileges.</h3>

<p>
  <a href="/account/update/<%= accountData.account_id %>">Update Account Information</a>
</p>

