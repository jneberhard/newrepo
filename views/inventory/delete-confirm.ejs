
<h1><%= title %></h1>
<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>


<div class ="form-container">
    <div class="form-input">  
        <form class="form1" action="/inv/delete" method="post" id="deleteForm">
            <div>
                <label for="inv_make">Make</label>
                <input type="text" name="inv_make" id="inv_make" required readonly value="<%= inv_make %>">
            </div>
            <div>
                <label for="inv_model">Model</label>
                <input type="text" id="inv_model" name="inv_model" required readonly value="<%= inv_model %>">
            </div>
            <div>
                <label for="inv_year">Year</label>
                <input type="text" id="inv_year" name="inv_year" required readonly pattern="\d{4}" maxlength="4" value="<%= inv_year %>">
            </div>
            <div>
                <label for="inv_price">Price</label>
                <input type="number" id="inv_price" name="inv_price" required readonly min="0" value="<%= inv_price %>">
            </div>
            
            <button type="submit">Delete</button>
            <p>Confirm Deletion - The delete is permanent.</p>
            <input type="hidden" name="inv_id"
            <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
            <% } %>>
        </form>       
    </div>
</div>

